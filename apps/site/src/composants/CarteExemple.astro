---
import { carteExemple } from '../lib/exemple';
import Feu from './Feu.astro';

/** Le rapport d'exemple de l'accueil : calculé au build par le moteur sur le projet d'exemple. */
const carte = carteExemple();
---

<article
  aria-labelledby="exemple-titre"
  class="relative rounded-[22px] border border-bordure bg-surface p-5 shadow-[0_30px_60px_-36px_rgba(20,24,40,0.45)] sm:p-6"
>
  <p
    class="absolute -top-3 left-5 rounded-full bg-flash px-3 py-1 font-display text-xs font-semibold tracking-[0.08em] text-white uppercase"
  >
    Exemple
  </p>
  <div class="flex flex-wrap items-start justify-between gap-3 pt-1">
    <div>
      <h2 id="exemple-titre" class="font-display text-base font-semibold">{carte.titre}</h2>
      <p class="text-sm text-encre-2">{carte.sousTitre}</p>
    </div>
    <p class="text-right">
      <span class="block font-display text-3xl font-bold tracking-tight tabular-nums"
        >{carte.montant}</span
      >
      <span class="block text-xs text-encre-2">{carte.montantLibelle}</span>
    </p>
  </div>
  <ul class="mt-3 divide-y divide-bordure">
    {carte.feux.map((feu) => <Feu {...feu} />)}
  </ul>
  <p class="mt-3 text-xs text-encre-3">{carte.note}</p>
</article>
