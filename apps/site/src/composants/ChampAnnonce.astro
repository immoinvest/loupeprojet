---
/**
 * « Collez le lien de l'annonce » : formulaire GET vers Nouveau projet de l'application, qui lit le
 * paramètre `texte` (lien seul ou texte partagé). Fonctionne sans JavaScript ; rien ne passe par le site.
 */
import { PARAMETRE_TEXTE } from '../lib/liens';
import { LIENS } from '../liens-du-build';

interface Props {
  id: string;
  class?: string;
}

const { id, class: classe } = Astro.props;
const aide = `${id}-aide`;
---

<div class:list={['grid gap-3', classe]}>
  <form
    method="get"
    action={LIENS.nouveauProjet}
    class="flex flex-col gap-2 rounded-carte border-2 border-accent-bordure bg-surface p-2 shadow-[0_12px_32px_-20px_rgba(43,75,242,0.55)] focus-within:border-accent sm:flex-row"
  >
    <label for={id} class="sr-only">Lien de l'annonce</label>
    <input
      id={id}
      name={PARAMETRE_TEXTE}
      type="text"
      inputmode="url"
      required
      autocomplete="off"
      spellcheck="false"
      aria-describedby={aide}
      placeholder="Collez le lien de l'annonce"
      class="min-h-12 min-w-0 flex-1 rounded-encart bg-transparent px-3 text-base text-encre placeholder:text-encre-3 focus-visible:outline-none"
    />
    <button
      type="submit"
      class="min-h-12 rounded-encart bg-accent px-5 font-display text-[0.98rem] font-semibold text-white survol-plein"
    >
      Analyser mon annonce
    </button>
  </form>
  <p id={aide} class="text-sm text-encre-2">
    LeBonCoin, SeLoger, Bien'ici, PAP ou Logic-Immo. Gratuit, sans compte : l'analyse s'ouvre dans
    l'application Deklic.
  </p>
</div>
