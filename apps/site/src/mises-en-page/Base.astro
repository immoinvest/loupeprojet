---
import '@fontsource-variable/outfit';
import '@fontsource-variable/nunito-sans';
import '../styles/global.css';

import EnTete from '../composants/EnTete.astro';
import PiedDePage from '../composants/PiedDePage.astro';
import { SITE, urlAbsolue } from '../lib/site';

/** Squelette de toutes les pages : métadonnées, en-tête, contenu, pied de page. */
interface Props {
  titre: string;
  description: string;
  chemin: string;
  type?: 'website' | 'article';
  indexer?: boolean;
}

const { titre, description, chemin, type = 'website', indexer = true } = Astro.props;
const canonique = urlAbsolue(chemin);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    {!indexer && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.nom} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={urlAbsolue('/og-image.png')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#2b4bf2" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Guides Deklic" href="/rss.xml" />
    <slot name="tete" />
  </head>
  <body class="flex min-h-dvh flex-col bg-fond font-sans text-encre antialiased">
    <a
      href="#contenu"
      class="sr-only rounded-encart bg-accent px-4 py-2 font-semibold text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
      >Aller au contenu</a
    >
    <EnTete />
    <main id="contenu" class="flex-1">
      <slot />
    </main>
    <PiedDePage />
  </body>
</html>
