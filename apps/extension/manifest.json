{
  "manifest_version": 3,
  "name": "Deklic",
  "version": "0.1.0",
  "description": "Lit l'annonce ouverte (LeBonCoin, SeLoger, Bien'ici, PAP, Logic-Immo) et ouvre son analyse dans Deklic. Rien ne quitte votre navigateur.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Analyser dans Deklic",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icones/16.png",
      "32": "icones/32.png"
    }
  },
  "icons": {
    "16": "icones/16.png",
    "32": "icones/32.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  }
}
