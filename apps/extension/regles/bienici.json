{
  "version": "bienici-2026-09-13",
  "portail": "bienici",
  "donnees": { "url": "/realEstateAd.json?id={id}" },
  "champs": {
    "prix": [
      { "source": "donnees", "chemin": "price", "type": "montant" },
      { "source": "meta", "nom": "og:title", "regex": "(\\d[\\d\\s.]*)\\s*€", "type": "montant" }
    ],
    "typeBien": [
      {
        "source": "donnees",
        "chemin": "propertyType",
        "regex": "^flat$",
        "type": "texte",
        "valeur": "appartement"
      },
      {
        "source": "donnees",
        "chemin": "propertyType",
        "regex": "^house$",
        "type": "texte",
        "valeur": "maison"
      }
    ],
    "surface": [
      { "source": "donnees", "chemin": "surfaceArea", "type": "nombre" },
      {
        "source": "meta",
        "nom": "og:title",
        "regex": "(\\d+(?:[,.]\\d+)?)\\s*m²",
        "type": "nombre"
      }
    ],
    "pieces": [
      { "source": "donnees", "chemin": "roomsQuantity", "type": "entier" },
      { "source": "meta", "nom": "og:title", "regex": "(\\d+)\\s*pièces?", "type": "entier" }
    ],
    "chambres": [{ "source": "donnees", "chemin": "bedroomsQuantity", "type": "entier" }],
    "etage": [{ "source": "donnees", "chemin": "floor", "type": "etage" }],
    "ascenseur": [{ "source": "donnees", "chemin": "hasElevator", "type": "booleen" }],
    "dpe": [{ "source": "donnees", "chemin": "energyClassification", "type": "classe" }],
    "ges": [{ "source": "donnees", "chemin": "greenhouseGazClassification", "type": "classe" }],
    "chargesCopro": [
      { "source": "donnees", "chemin": "annualCondominiumFees", "type": "montant", "diviser": 12 }
    ],
    "anneeConstruction": [
      { "source": "donnees", "chemin": "yearOfConstruction", "type": "entier" }
    ],
    "lotsCopro": [{ "source": "donnees", "chemin": "condominiumPartsQuantity", "type": "entier" }],
    "coproEnProcedure": [
      { "source": "donnees", "chemin": "isCondominiumInProcedure", "type": "booleen" }
    ],
    "meuble": [{ "source": "donnees", "chemin": "isFurnished", "type": "booleen" }],
    "ville": [{ "source": "donnees", "chemin": "city", "type": "texte" }],
    "codePostal": [
      { "source": "donnees", "chemin": "postalCode", "type": "codePostal" },
      { "source": "meta", "nom": "og:title", "type": "codePostal" }
    ],
    "description": [
      { "source": "donnees", "chemin": "description", "type": "texte" },
      { "source": "meta", "nom": "og:description", "type": "texte" }
    ]
  }
}
