{
  "version": "seloger-2026-09-13",
  "portail": "seloger",
  "champs": {
    "prix": [
      {
        "source": "jsonld",
        "chemin": "offers.price",
        "typeLd": "RealEstateListing",
        "type": "montant"
      },
      {
        "source": "json",
        "selecteur": "#__UFRN_LIFECYCLE_SERVERREQUEST__",
        "chemin": "app_cldp.data.classified.sections.mortgage.price",
        "type": "montant"
      },
      { "source": "meta", "nom": "og:title", "regex": "(\\d[\\d\\s.]*)\\s*€", "type": "montant" }
    ],
    "typeBien": [
      {
        "source": "json",
        "selecteur": "#__UFRN_LIFECYCLE_SERVERREQUEST__",
        "chemin": "app_cldp.data.classified.rawData.propertyType",
        "regex": "^apartment$",
        "type": "texte",
        "valeur": "appartement"
      },
      {
        "source": "json",
        "selecteur": "#__UFRN_LIFECYCLE_SERVERREQUEST__",
        "chemin": "app_cldp.data.classified.rawData.propertyType",
        "regex": "^house$",
        "type": "texte",
        "valeur": "maison"
      }
    ],
    "surface": [
      {
        "source": "json",
        "selecteur": "#__UFRN_LIFECYCLE_SERVERREQUEST__",
        "chemin": "app_cldp.data.classified.sections.hardFacts.facts[type=livingSpace].splitValue",
        "type": "nombre"
      },
      {
        "source": "jsonld",
        "chemin": "itemOffered.floorSize.value",
        "typeLd": "RealEstateListing",
        "type": "nombre"
      },
      {
        "source": "meta",
        "nom": "og:title",
        "regex": "(\\d+(?:[,.]\\d+)?)\\s*m²",
        "type": "nombre"
      }
    ],
    "pieces": [
      {
        "source": "json",
        "selecteur": "#__UFRN_LIFECYCLE_SERVERREQUEST__",
        "chemin": "app_cldp.data.classified.sections.hardFacts.facts[type=numberOfRooms].splitValue",
        "type": "entier"
      },
      {
        "source": "jsonld",
        "chemin": "itemOffered.numberOfRooms",
        "typeLd": "RealEstateListing",
        "type": "entier"
      },
      { "source": "meta", "nom": "og:title", "regex": "(\\d+)\\s*pièces?", "type": "entier" }
    ],
    "chambres": [
      {
        "source": "json",
        "selecteur": "#__UFRN_LIFECYCLE_SERVERREQUEST__",
        "chemin": "app_cldp.data.classified.sections.hardFacts.facts[type=numberOfBedrooms].splitValue",
        "type": "entier"
      }
    ],
    "etage": [
      {
        "source": "json",
        "selecteur": "#__UFRN_LIFECYCLE_SERVERREQUEST__",
        "chemin": "app_cldp.data.classified.sections.features.preview[icon=floors].value",
        "regex": "(\\d+)\\s*(?:er|e|ème)?\\s*étage|rez-de-chauss\\S*",
        "type": "etage"
      },
      {
        "source": "json",
        "selecteur": "#__UFRN_LIFECYCLE_SERVERREQUEST__",
        "chemin": "app_cldp.data.classified.sections.hardFacts.facts[type=numberOfFloors].label",
        "regex": "^(\\d+)/",
        "type": "etage"
      }
    ],
    "ascenseur": [
      {
        "source": "json",
        "selecteur": "#__UFRN_LIFECYCLE_SERVERREQUEST__",
        "chemin": "app_cldp.data.classified.sections.features.preview[icon=elevator].value",
        "regex": "^pas d",
        "type": "booleen",
        "valeur": false
      },
      {
        "source": "json",
        "selecteur": "#__UFRN_LIFECYCLE_SERVERREQUEST__",
        "chemin": "app_cldp.data.classified.sections.features.preview[icon=elevator].value",
        "regex": "ascenseur",
        "type": "booleen",
        "valeur": true
      }
    ],
    "dpe": [
      {
        "source": "json",
        "selecteur": "#__UFRN_LIFECYCLE_SERVERREQUEST__",
        "chemin": "app_cldp.data.classified.sections.energy.certificates[0].scales[type=FR_ENERGY_AFTER_2021].efficiencyClass.rating",
        "type": "classe"
      },
      {
        "source": "json",
        "selecteur": "#__UFRN_LIFECYCLE_SERVERREQUEST__",
        "chemin": "app_cldp.data.classified.sections.energy.certificates[0].scales[type=FR_ENERGY_BEFORE_2021].efficiencyClass.rating",
        "type": "classe"
      }
    ],
    "ges": [
      {
        "source": "json",
        "selecteur": "#__UFRN_LIFECYCLE_SERVERREQUEST__",
        "chemin": "app_cldp.data.classified.sections.energy.certificates[0].scales[type=FR_GHG_AFTER_2021].efficiencyClass.rating",
        "type": "classe"
      },
      {
        "source": "json",
        "selecteur": "#__UFRN_LIFECYCLE_SERVERREQUEST__",
        "chemin": "app_cldp.data.classified.sections.energy.certificates[0].scales[type=FR_GHG_BEFORE_2021].efficiencyClass.rating",
        "type": "classe"
      }
    ],
    "ville": [
      {
        "source": "json",
        "selecteur": "#__UFRN_LIFECYCLE_SERVERREQUEST__",
        "chemin": "app_cldp.data.classified.sections.location.address.city",
        "type": "texte"
      }
    ],
    "codePostal": [
      {
        "source": "json",
        "selecteur": "#__UFRN_LIFECYCLE_SERVERREQUEST__",
        "chemin": "app_cldp.data.classified.sections.location.address.zipCode",
        "type": "codePostal"
      },
      { "source": "meta", "nom": "og:title", "type": "codePostal" }
    ],
    "description": [
      {
        "source": "json",
        "selecteur": "#__UFRN_LIFECYCLE_SERVERREQUEST__",
        "chemin": "app_cldp.data.classified.sections.description.description",
        "type": "texte"
      },
      {
        "source": "jsonld",
        "chemin": "description",
        "typeLd": "RealEstateListing",
        "type": "texte"
      },
      { "source": "meta", "nom": "og:description", "type": "texte" }
    ]
  }
}
