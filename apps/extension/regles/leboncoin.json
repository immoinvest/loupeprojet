        "source": "json",
        "selecteur": "#__NEXT_DATA__",
        "chemin": "props.pageProps.ad.attributes[key=square].value",
        "type": "nombre"
      },
      {
        "source": "css",
        "selecteur": "[data-qa-id=\"criteria_item_square\"]",
        "regex": "(\\d+(?:[,.]\\d+)?)\\s*m",
        "type": "nombre"
      }
    ],
    "pieces": [
