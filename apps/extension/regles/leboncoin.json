{
  "version": "leboncoin-2026-09-13",
  "portail": "leboncoin",
  "champs": {
    "prix": [
      {
        "source": "json",
        "selecteur": "#__NEXT_DATA__",
        "chemin": "props.pageProps.ad.price[0]",
        "type": "montant"
      },
      {
        "source": "json",
        "selecteur": "#__NEXT_DATA__",
        "chemin": "props.pageProps.ad.price",
        "type": "montant"
      },
      { "source": "css", "selecteur": "[data-qa-id=\"adview_price\"]", "type": "montant" }
    ],
    "typeBien": [
      {
        "source": "json",
        "selecteur": "#__NEXT_DATA__",
        "chemin": "props.pageProps.ad.attributes[key=real_estate_type].value_label",
        "regex": "^appartement",
        "type": "texte",
        "valeur": "appartement"
      },
      {
        "source": "json",
        "selecteur": "#__NEXT_DATA__",
        "chemin": "props.pageProps.ad.attributes[key=real_estate_type].value_label",
