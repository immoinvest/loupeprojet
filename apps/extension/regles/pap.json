{
  "version": "pap-2026-09-14",
  "portail": "pap",
  "champs": {
    "prix": [
      { "source": "jsonld", "chemin": "offers.price", "typeLd": "Product", "type": "montant" },
      { "source": "css", "selecteur": "h1.item-title .item-price", "type": "montant" }
    ],
    "typeBien": [
      {
        "source": "jsonld",
        "chemin": "additionalProperty[name=Type de bien].value",
        "typeLd": "Product",
        "regex": "^appartement",
        "type": "texte",
        "valeur": "appartement"
      },
      {
        "source": "jsonld",
        "chemin": "additionalProperty[name=Type de bien].value",
        "typeLd": "Product",
        "regex": "^maison",
        "type": "texte",
        "valeur": "maison"
      }
    ],
    "surface": [
      {
        "source": "jsonld",
        "chemin": "additionalProperty[name=Surface].value",
        "typeLd": "Product",
        "type": "nombre"
      },
      {
        "source": "css",
        "selecteur": "ul.item-tags li",
        "regex": "(\\d+(?:[,.]\\d+)?)\\s*m²",
        "type": "nombre"
      }
    ],
    "pieces": [
      {
        "source": "jsonld",
        "chemin": "additionalProperty[name=Nombre de pièces].value",
        "typeLd": "Product",
        "type": "entier"
      },
      {
        "source": "css",
        "selecteur": "ul.item-tags li",
        "regex": "(\\d+)\\s*pièces?",
        "type": "entier"
      }
    ],
    "chambres": [
      {
        "source": "css",
        "selecteur": "ul.item-tags li",
        "regex": "(\\d+)\\s*chambres?",
        "type": "entier"
      }
    ],
    "ville": [
      {
        "source": "jsonld",
        "chemin": "address.addressLocality",
        "typeLd": "Product",
        "type": "texte"
      },
      {
        "source": "css",
        "selecteur": ".item-description h2",
        "regex": "^(.+?)\\s*\\(\\d{5}\\)",
        "type": "texte"
      }
    ],
    "codePostal": [
      {
        "source": "jsonld",
        "chemin": "address.postalCode",
        "typeLd": "Product",
        "type": "codePostal"
      },
      { "source": "css", "selecteur": ".item-description h2", "type": "codePostal" }
    ],
    "adresse": [
      {
        "source": "jsonld",
        "chemin": "address.streetAddress",
        "typeLd": "Product",
        "type": "texte"
      }
    ],
    "photos": [{ "source": "jsonld", "chemin": "image", "typeLd": "Product", "type": "urls" }],
    "ascenseur": [
      {
        "source": "jsonld",
        "chemin": "additionalProperty[name=Ascenseur].value",
        "typeLd": "Product",
        "type": "booleen"
      }
    ],
    "balcon": [
      {
        "source": "jsonld",
        "chemin": "additionalProperty[name=Balcon / Terrasse].value",
        "typeLd": "Product",
        "type": "booleen"
      }
    ],
    "vendeur": [
      {
        "source": "jsonld",
        "chemin": "offers.seller.name",
        "typeLd": "Product",
        "regex": "^particulier",
        "type": "texte",
        "valeur": "particulier"
      }
    ],
    "dpe": [{ "source": "css", "selecteur": ".energy-indice li.active", "type": "classe" }],
    "ges": [{ "source": "css", "selecteur": ".ges-indice li.active", "type": "classe" }],
    "description": [
      { "source": "jsonld", "chemin": "description", "typeLd": "Product", "type": "texte" },
      { "source": "css", "selecteur": ".item-description p", "type": "texte" },
      { "source": "meta", "nom": "og:description", "type": "texte" }
    ]
  }
}
